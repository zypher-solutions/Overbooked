# Copy to .env.local and fill in from `npx supabase status` (local) or your own Overbooked Supabase project.
# Never put TRENDZ keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC. Local value: `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
