# Copy to .env.local and fill in from `npx supabase status` (local) or your own Overbooked Supabase project.
# Never put TRENDZ keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC. Local value: `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Emails the app sends itself (master password reset alert): a Resend key with sending access only,
# and the sender, e.g. Overbooked <no-reply@your-domain>. See docs/SETUP.md, "Real email".
RESEND_API_KEY=
EMAIL_FROM=
